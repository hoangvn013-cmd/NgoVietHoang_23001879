<?php

$students = [
    [
        "name" => "Nguyen Van An",
        "age" => 20,
        "score" => 8.5
    ],
    [
        "name" => "Tran Thi Binh",
        "age" => 21,
        "score" => 6.5
    ],
    [
        "name" => "Le Van Cuong",
        "age" => 19,
        "score" => 4.5
    ],
    [
        "name" => "Pham Thi Dung",
        "age" => 20,
        "score" => 7.5
    ]
];

// 1. In thông tin của tất cả sinh viên
echo "Danh sách sinh viên:<br>";

foreach ($students as $student) {
    echo "Họ tên: " . $student["name"] . 
         " - Tuổi: " . $student["age"] . 
         " - Điểm: " . $student["score"] . "<br>";
}

// 2. Tính điểm trung bình
$totalScore = 0;

foreach ($students as $student) {
    $totalScore += $student["score"];
}

$averageScore = $totalScore / count($students);

echo "<br>Điểm trung bình của tất cả sinh viên: " . $averageScore;

?>
