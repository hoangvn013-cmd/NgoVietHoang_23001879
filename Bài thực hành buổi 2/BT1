<?php
class CartItem {
    public $name;
    public $price;
    public $quantity;

    public function __construct($name, $price, $quantity) {

        if ($price <= 0) {
            throw new Exception("Giá phải lớn hơn 0");
        }

        if ($quantity <= 0) {
            throw new Exception("Số lượng phải lớn hơn 0");
        }

        $this->name = $name;
        $this->price = $price;
        $this->quantity = $quantity;
    }

    public function getTotal() {
        return $this->price * $this->quantity;
    }
}
class ShoppingCart {
  public $items = [];
  public function addItem($item){
  if (!($item instanceof CartItem)) {
            throw new Exception("Chỉ được thêm đối tượng CartItem.");
        }
  $this->items[] = $item;
}
public function removeItem($name){
  foreach($this->items as $key => $item) {
    if($item->name == $name){
      unset($this->items[$key]);
        $this->items = array_values($this->items);
        echo "Đã xóa sản phẩm: " . $name . "\n";
      return;
    }
    }
    echo "Không tìm thấy sản phẩm: " . $name . "<br>";
  }
public function calculateTotal(){
  $total = 0;
  foreach ($this->items as $item) {
    $total += $item->getTotal();
  }
  return $total;
}
public function displayCart() {
    if (empty($this->items)) {
        echo "Giỏ hàng không có sản phẩm.\n";
        return;
    }

    echo "Danh sách sản phẩm:\n\n";

    foreach ($this->items as $item) {
        echo "Tên sản phẩm: " . $item->name . "\n";
        echo "Đơn giá: " . number_format($item->price) . " VNĐ\n";
        echo "Số lượng: " . $item->quantity . "\n";
        echo "Thành tiền: " . number_format($item->getTotal()) . " VNĐ\n";
        echo "-----------------------------\n";
    }

    echo "Tổng tiền: "
        . number_format($this->calculateTotal())
        . " VNĐ\n";
}
}
try {

    $cart = new ShoppingCart();

    $item1 = new CartItem("Laptop", 15000000, 1);
    $item2 = new CartItem("Chuột", 500000, 2);
    $item3 = new CartItem("Bàn phím", 800000, 1);
    $item4 = new CartItem("Tai nghe", 1200000, 2);

    $cart->addItem($item1);
    $cart->addItem($item2);
    $cart->addItem($item3);
    $cart->addItem($item4);
  
  echo "\n===== GIỎ HÀNG BAN ĐẦU =====\n";
$cart->displayCart();

echo "\nTổng tiền: "
    . number_format($cart->calculateTotal())
    . " VNĐ\n";

$cart->removeItem("Chuột");

echo "\n===== GIỎ HÀNG SAU KHI XÓA =====\n";
$cart->displayCart();

} catch (Exception $e) {
    echo "Lỗi: " . $e->getMessage() . "\n";
}
?>
